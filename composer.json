{
    "name": "percona/learnomancer",
    "description": "A collection of CLI tools to manage training instances in AWS",
    "type": "project",
    "bin": [
    	"bin/learnomancer"
    ],
    "require": {
        "cakephp/console": "^5.3",
        "aws/aws-sdk-php": "^3.376"
    },
    "require-dev": {
    	"phpstan/phpstan": "^2.1",
    	"cakephp/cakephp-codesniffer": "^5.3",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Learnomancer\\": "src/"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check"
        ],
        "cs-check": "phpcs -s",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --memory-limit=256M",
        "test": "phpunit --colors=always",
        "lint": "parallel-lint --exclude .git --exclude vendor ."
    },
    "authors": [
        {
            "name": "Matthew Boehm",
            "email": "matthew.boehm@percona.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
